datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

model Staff {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("staff") // owner, staff
  visits       Visit[]
}

model Table {
  id         Int            @id @default(autoincrement())
  number     Int
  name        String?        // Custom table name/label (e.g. "VIP 1", "Corner Table")
  gameType    String         @default("Pool") // Pool, MidSnooker
  ratePerHour Float?         // Custom hourly price/rate in ₹ (e.g. 160, 220, 250)
  status     String         @default("available") // available, occupied
  bookings   TableBooking[]
  tablePlays TablePlay[]

  @@unique([gameType, number])
}

model MenuItem {
  id            Int            @id @default(autoincrement())
  name          String
  price         Float
  category      String         // Cafe, Cold Drinks, Cigarettes
  isActive      Boolean        @default(true) // Active item in current menu; false if soft-deleted
  orders        Order[]
  inventoryItem InventoryItem?
}

model Customer {
  id               Int            @id @default(autoincrement())
  firstName        String
  lastName         String         @default("")
  name             String         // Full combined name "firstName lastName"
  phone            String         @unique
  currentCreditDue Float          @default(0) // Live outstanding balance
  lifetimeSpend    Float          @default(0)
  lifetimePaid     Float          @default(0)
  totalVisits      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  visits           Visit[]
  payments         Payment[]
  creditRecords    CreditRecord[]
  legacySessions   LegacySession[]

  @@index([phone])
  @@index([name])
}

model Visit {
  id                   String         @id // e.g. "V_19102026172705_chiragjain"
  customerId           Int
  customer             Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  startTime            DateTime       @default(now())
  endTime              DateTime?
  status               String         @default("active") // "active" | "completed"
  staffUsername        String
  staff                Staff          @relation(fields: [staffUsername], references: [username])

  // Financial summary for this visit
  itemsTotal           Float          @default(0)
  tablesTotal          Float          @default(0)
  customAmount         Float          @default(0)
  visitTotal           Float          @default(0)
  paidAmount           Float          @default(0)
  balanceDue           Float          @default(0)
  paymentStatus        String         @default("pending") // "pending" | "paid" | "credit" | "partially_paid"

  orders               Order[]
  tablePlays           TablePlay[]
  payments             Payment[]
  creditRecords        CreditRecord[]

  @@index([customerId])
  @@index([status])
  @@index([startTime])
}

model TablePlay {
  id          Int       @id @default(autoincrement())
  visitId     String
  visit       Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  tableId     Int?      // null for PS4
  table       Table?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  gameType    String    // Pool, MidSnooker, PS4
  playerCount Int       @default(1)
  startTime   DateTime  @default(now())
  endTime     DateTime?
  cost        Float     @default(0)
  createdBy   String    // staff username

  @@index([visitId])
  @@index([tableId])
}

model Order {
  id         Int      @id @default(autoincrement())
  visitId    String
  visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Float    // price at ordering time
  createdAt  DateTime @default(now())

  @@index([visitId])
  @@index([menuItemId])
}

model Payment {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visitId    String?
  visit      Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  amount     Float
  method     String   // Cash, UPI
  type       String   @default("visit_payment") // "visit_payment" | "credit_settlement"
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([visitId])
}

model CreditRecord {
  id            Int       @id @default(autoincrement())
  customerId    Int
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visitId       String?
  visit         Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  amount        Float
  settledAmount Float     @default(0)
  status        String    @default("unpaid") // "unpaid" | "paid"
  notes         String?
  createdAt     DateTime  @default(now())

  @@index([customerId])
  @@index([status])
  @@index([visitId])
}

model TableBooking {
  id            Int      @id @default(autoincrement())
  tableId       Int
  table         Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customerName  String
  contactNumber String?
  bookingTime   DateTime
  createdAt     DateTime @default(now())

  @@index([tableId])
}

model LegacySession {
  id              String    @id // Original production session ID (e.g. "27102026005118_harshit")
  customerId      Int
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName    String
  customerPhone   String?
  
  // Timing & Staff Info
  startTime       DateTime
  endTime         DateTime?
  status          String    // "completed" | "active"
  staffUsername   String?
  
  // Financial Summary
  tablesTotal     Float     @default(0) // gameCost
  itemsTotal      Float     @default(0) // menuCost
  customAmount    Float     @default(0)
  totalBill       Float     @default(0)
  paidAmount      Float     @default(0)
  balanceDue      Float     @default(0)
  paymentStatus   String    // "paid" | "partially_paid" | "credit"
  
  // Itemized Historical Details as JSON
  orders          Json?
  tablePlays      Json?
  payments        Json?
  
  createdAt       DateTime  @default(now())

  @@index([customerId])
  @@index([startTime])
}

model InventoryItem {
  id            Int                    @id @default(autoincrement())
  name          String
  category      String                 // "Cafe" | "Club" (User requirement!)
  subCategory   String?                // "Cigarettes", "Cold Drinks", "Snacks", "Raw Materials", "Gaming Supplies"
  currentStock  Int                    @default(0) // In loose pieces / basic units
  unit          String                 @default("pieces") // "pieces", "cans", "bottles", "packets", "boxes"
  piecesPerBox  Int                    @default(1) // Number of loose pieces in 1 wholesale box/packet
  minStockAlert Int                    @default(10) // Low stock threshold (in pieces)
  costPrice     Float?                 // Purchase cost per box or per piece
  sellingPrice  Float?                 // Retail selling price per piece
  menuItemId    Int?                   @unique
  menuItem      MenuItem?              @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  transactions  InventoryTransaction[]

  @@index([category])
  @@index([subCategory])
  @@index([isActive])
}

model InventoryTransaction {
  id            Int           @id @default(autoincrement())
  itemId        Int
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          String        // "RESTOCK" | "SALE" | "ADJUSTMENT" | "WASTAGE" | "RETURN"
  quantity      Int           // Loose units change (e.g. +50, -2)
  boxesCount    Float?        // If restocked by boxes (e.g. 5 boxes)
  piecesPerBox  Int?          // E.g. 10 or 20
  unitCost      Float?        // Cost per box/pack or piece
  totalCost     Float?        // Total restock expense
  stockBefore   Int
  stockAfter    Int
  notes         String?
  staffUsername String?
  createdAt     DateTime      @default(now())

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
}

model CustomerFeedback {
  id               Int      @id @default(autoincrement())
  customerName     String?
  customerPhone    String?
  customerEmail    String?
  ratingOverall    Int      // 1-5
  ratingTables     Int?     // 1-5
  ratingVibe       Int?     // 1-5
  ratingFood       Int?     // 1-5
  ratingStaff      Int?     // 1-5
  tags             String?  // Comma-separated badges/tags
  sentiment        String   // "positive" | "negative" | "neutral"
  generatedReview  String?  @db.Text
  privateFeedback  String?  @db.Text // If negative rating, complaint message
  postedToGoogle   Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([customerPhone])
  @@index([sentiment])
  @@index([createdAt])
}
